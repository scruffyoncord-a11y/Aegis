rules_version = '2';

// PLANTED FLAW (Phase 3): world-open Firestore rules.
// `allow read, write: if true;` lets anyone on the internet read and write
// the entire database with no authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
