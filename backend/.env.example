# Copy this file to .env and fill in your own GitHub OAuth App credentials.
# .env is git-ignored -- never commit real values.
# See README.md "GitHub OAuth App" for how to create the OAuth App.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only change these if you're running the backend/frontend on non-default ports.
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/github/oauth/callback
# AEGIS_FRONTEND_URL=http://localhost:3000

# Optional: override the local LLM model (default: ollama:qwen2.5-coder:7b)
# AEGIS_LLM_MODEL=ollama:qwen2.5-coder:7b
